# Copy to .env and fill in. .env is ignored by Git.
# A variable is added here when a stage first needs it.

# The ML II bond-month panel (parquet), with its manifest.json beside it. Keep it outside this repo.
PANEL_PATH=

# Spark Connect server (sc://host:port). When set, Spark runs on that cluster and the
# two settings below are ignored. GraphFrames must then be installed on the server.
SPARK_REMOTE=

# Local Spark only: the master and the GraphFrames Spark package, matched to the
# local Spark and Scala versions.
SPARK_MASTER=local[*]
GRAPHFRAMES_PACKAGE=io.graphframes:graphframes-spark4_2.13:0.12.3
