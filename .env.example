# Copy to .env and fill in. .env is ignored by Git.

# Folder that holds all licensed data. Keep it outside this repo.
DATA_DIR=

# The ML II bond-month panel (parquet), used in stage (a).
PANEL_PATH=

# WRDS username. The password goes in ~/.pgpass, as the wrds package expects.
WRDS_USERNAME=

# Spark Connect server (sc://host:port). When set, Spark runs on that cluster and the
# two settings below are ignored. GraphFrames must then be installed on the server.
SPARK_REMOTE=

# Local Spark only: the master and the GraphFrames Spark package, matched to the
# local Spark and Scala versions.
SPARK_MASTER=local[*]
GRAPHFRAMES_PACKAGE=io.graphframes:graphframes-spark4_2.13:0.12.3

# One-off Bloomberg CDS pull for stage (e).
BBG_CDS_PATH=

# Parsed XBRL facts from SEC EDGAR for stage (h), exported to a local file.
XBRL_FACTS_PATH=

# Declared User-Agent for SEC EDGAR requests, as the SEC requires (name and contact).
SEC_USER_AGENT=
